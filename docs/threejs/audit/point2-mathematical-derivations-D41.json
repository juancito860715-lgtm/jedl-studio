      "record_key": "D41:0",
      "name": "Reaction–diffusion Gray–Scott",
      "starting_principles": "D_u,D_v,F,k≥0; campos y Δt definidos.",
      "derivation": [
        {
          "step": 1,
          "equation": "u_t=D_u∇²u−uv²+F(1−u)",
          "justification": "Difusión, reacción y reposición de u."
        },
        {
          "step": 2,
          "equation": "v_t=D_v∇²v+uv²−(F+k)v",
          "justification": "Difusión, producción y eliminación de v."
        },
        {
          "step": 3,
          "equation": "discretize ∇²; integrate u,v",
          "justification": "Resolver campos acoplados."
        }
      ],
      "assumptions": [
        "D_u,D_v,F,k≥0; campos y Δt definidos."
      ],
      "result": "Gray–Scott combina difusión y reacción no lineal.",
      "limits": [
        "Patrones dependen de F,k,D y resolución."
      ]
    },
    {
      "record_key": "D41:1",
      "name": "Flocking de Reynolds",
      "starting_principles": "Vecindad definida; pesos homogéneos a aceleración.",
      "derivation": [
        {
          "step": 1,
          "equation": "S_i=−Σ_j(p_j−p_i)/||p_j−p_i||²",
          "justification": "Separación."
        },
        {
          "step": 2,
          "equation": "A_i=mean(v_j)−v_i; C_i=mean(p_j)−p_i",
          "justification": "Alineación y cohesión."
        },
        {
          "step": 3,
          "equation": "a_i=w_sS_i+w_aA_i+w_cC_i; v'=limit(v+aΔt)",
          "justification": "Combinar reglas e integrar."
        }
      ],
      "assumptions": [
        "Vecindad definida; pesos homogéneos a aceleración."
      ],
      "result": "Reynolds combina separación, alineación y cohesión.",
      "limits": [
        "Pesos mal tipados producen aceleraciones incoherentes."
      ]
    },
    {
      "record_key": "D41:2",
      "name": "Brownian motion",
      "starting_principles": "Incrementos gaussianos independientes; Δt≥0.",
      "derivation": [
        {
          "step": 1,
          "equation": "ΔW∼N(0,Δt)",
          "justification": "Incremento Wiener."
        },
        {
          "step": 2,
          "equation": "ΔX=μΔt+σΔW",
          "justification": "Deriva más difusión."
        },
        {
          "step": 3,
          "equation": "X_{n+1}=X_n+μΔt+σ√Δt ξ",
          "justification": "Muestrear ξ normal estándar."
        }
      ],
      "assumptions": [
        "Incrementos gaussianos independientes; Δt≥0."
      ],
      "result": "Brownian motion suma deriva e incremento Wiener.",
      "limits": [
        "Trayectorias no diferenciables; no inferir velocidad instantánea clásica."
      ]
    },
    {
      "record_key": "D41:3",
      "name": "Ornstein–Uhlenbeck process",
      "starting_principles": "θ>0; unidades temporales coherentes.",
      "derivation": [
        {
          "step": 1,
          "equation": "dX=θ(μ−X)dt+σdW",
          "justification": "Retorno a media y ruido."
        },
        {
          "step": 2,
          "equation": "mean=μ+(X_n−μ)e^(−θΔt)",
          "justification": "Resolver parte determinista."
        },
        {
          "step": 3,
          "equation": "variance=σ²(1−e^(−2θΔt))/(2θ)",
          "justification": "Integrar varianza."
        },
        {
          "step": 4,
          "equation": "X_{n+1}=mean+√variance·ξ",
          "justification": "Actualización exacta."
        }
      ],
      "assumptions": [
        "θ>0; unidades temporales coherentes."
      ],
      "result": "OU incorpora retorno a media con actualización exponencial.",
      "limits": [
        "Euler puede sesgar OU; usar actualización exacta."
      ]
    },
