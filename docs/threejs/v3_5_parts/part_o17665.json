 "glossary": [
  {
   "term": "SDF",
   "definition": "Función que devuelve distancia firmada aproximada a la superficie de una forma."
  },
  {
   "term": "Ray marching",
   "definition": "Avanzar un rayo en pasos calculados a partir de un campo o densidad hasta encontrar superficie o acumular volumen."
  },
  {
   "term": "PBR",
   "definition": "Renderizado basado en modelos físicos aproximados de interacción entre luz y materiales."
  },
  {
   "term": "BRDF",
   "definition": "Función que describe cómo una superficie refleja luz entre direcciones incidentes y salientes."
  },
  {
   "term": "LOD",
   "definition": "Nivel de detalle seleccionado según distancia, tamaño en pantalla o presupuesto."
  },
  {
   "term": "AO",
   "definition": "Oclusión ambiental; aproximación del oscurecimiento en zonas cercanas y cavidades."
  },
  {
   "term": "HDR",
   "definition": "Representación de valores de luz superiores al rango final de pantalla."
  },
  {
   "term": "UV",
   "definition": "Coordenadas 2D que relacionan puntos de una superficie con una textura."
  },
  {
   "term": "Instancing",
   "definition": "Dibujar muchas copias de una geometría con transformaciones y atributos distintos."
  },
  {
   "term": "G-buffer",
   "definition": "Conjunto de buffers que guardan atributos de superficie como color, normal y profundidad."
  },
  {
   "term": "PMREM",
   "definition": "Prefiltrado de mapas de entorno para iluminación basada en imagen."
  },
  {
   "term": "TBN",
   "definition": "Base tangente-bitangente-normal usada para transformar normales de espacio tangente."
  },
  {
   "term": "Quaternion",
   "definition": "Representación de rotación 3D que evita varios problemas de interpolación de ángulos Euler."
  },
  {
   "term": "fBm",
   "definition": "Suma de capas de ruido con frecuencias y amplitudes crecientes/decrecientes."
  },
  {
   "term": "Domain warping",
   "definition": "Deformar las coordenadas de entrada de una función para crear patrones complejos."
  },
  {
   "term": "OIT",
   "definition": "Ordenamiento independiente de transparencia; familia de técnicas para combinar superficies transparentes."
  },
  {
   "term": "Temporal accumulation",
   "definition": "Combinar muestras de distintos instantes para suavizar o aproximar efectos."
  }
 ],
