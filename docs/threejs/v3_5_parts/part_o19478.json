 "derivation_workbook_v3": [
  {
   "topic": "De una ley de conservación a una simulación",
   "steps": [
    "Partir de una cantidad conservada q por volumen.",
    "Aplicar balance: tasa de cambio + flujo neto = fuentes.",
    "Aplicar teorema de divergencia para pasar de frontera a volumen.",
    "Obtener PDE conservativa.",
    "Discretizar dominio y tiempo.",
    "Elegir solver, condiciones de contorno y criterios de estabilidad."
   ],
   "generic_equation": "∂U/∂t+∇·F(U)=S(U)",
   "important": "Una ecuación continua no define por sí sola el resultado visual; se necesitan dominio, unidades, parámetros, condiciones iniciales/de contorno y discretización."
  },
  {
   "topic": "De una curva de personaje a movimiento",
   "steps": [
    "Definir trayectoria P(t).",
    "Derivar velocidad v(t)=dP/dt.",
    "Derivar aceleración a(t)=d²P/dt².",
    "Orientar el cuerpo según tangente y marco de Frenet o parallel transport.",
    "Añadir ondas articulares con desfase.",
    "Resolver contactos y restricciones.",
    "Aplicar secundarios con osciladores amortiguados."
   ],
   "generic_equation": "v=P'; a=P''; T=P'/|P'|",
   "important": "Evitar Frenet cuando curvatura se aproxima a cero; usar parallel transport frame para evitar giros bruscos."
  },
  {
   "topic": "De anatomía a deformación de piel",
   "steps": [
    "Definir huesos y articulaciones en pose de reposo.",
    "Definir volúmenes de músculos y tejidos.",
    "Vincular músculo a huesos e inserciones.",
    "Calcular contracción y cambio de volumen aproximado.",
    "Aplicar skinning base.",
    "Aplicar correctivos de pose y deformación local.",
    "Resolver colisiones y deslizamiento.",
    "Actualizar normales y detalles de piel."
   ],
   "generic_equation": "p'=Skin(p,M,w)+Σ_k c_kΔp_k+Δp_muscle",
   "important": "La biomecánica completa requiere constitutivas, contactos y solver; el rig de producción suele combinar métodos geométricos y aproximaciones."
  },
  {
   "topic": "De BRDF a material",
   "steps": [
    "Definir energía incidente y dirección de vista.",
    "Separar reflexión difusa, especular y transmisión.",
    "Elegir distribución de microfacetas D.",
    "Elegir Fresnel F.",
    "Elegir masking-shadowing G.",
    "Definir absorción, dispersión o capas si procede.",
    "Verificar conservación energética y espacio de color."
   ],
   "generic_equation": "f_r=f_diffuse+ DFG/[4(N·L)(N·V)]",
   "important": "Roughness no es brillo arbitrario: modifica distribución de microfacetas y ancho del lóbulo."
  },
  {
   "topic": "De un campo procedural a geometría",
   "steps": [
    "Definir función escalar f(x) o SDF d(x).",
    "Elegir dominio y frecuencia espacial.",
    "Combinar primitivas con CSG o smooth operators.",
    "Añadir deformaciones y ruido con gradientes controlados.",
    "Extraer iso-superficie o raymarch.",
    "Calcular normales con gradiente.",
    "Validar topología y resolución."
   ],
   "generic_equation": "Surface={x|f(x)=0}; n=normalize(∇f)",
   "important": "El ruido debe escalar con tamaño de objeto; aliasing y resolución afectan silueta."
  },
  {
   "topic": "De estilo visual a parámetros controlables",
   "steps": [
    "Describir rasgos visuales observables.",
    "Separar forma, material, luz, cámara, color y movimiento.",
    "Asignar parámetros numéricos por familia.",
    "Crear presets no destructivos.",
    "Aplicar a personaje y entorno por separado.",
    "Revisar consistencia en distintos planos y escalas."
   ],
   "generic_equation": "Style(scene)=Compose(G_style,M_style,L_style,C_style,A_style,P_style)",
