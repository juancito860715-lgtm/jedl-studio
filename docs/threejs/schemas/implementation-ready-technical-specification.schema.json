{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jedl-studio.github.io/schemas/implementation-ready-technical-specification.schema.json",
  "title": "Implementation-ready technical specification for a Three.js technique",
  "type": "object",
  "required": [
    "record_key",
    "name",
    "formulation_type",
    "variables",
    "equations",
    "derivation",
    "assumptions",
    "valid_domain",
    "boundary_conditions",
    "inputs",
    "outputs",
    "algorithm_steps",
    "pseudocode",
    "complexity",
    "implementation_mapping",
    "source_claims",
    "independent_tests",
    "readiness_status"
  ],
  "properties": {
    "record_key": {
      "type": "string",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "formulation_type": {
      "enum": [
        "physical_law",
        "constitutive_model",
        "geometric_method",
        "numerical_solver",
        "procedural_rule",
        "rendering_approximation",
        "art_direction_recipe",
        "data_structure",
        "other"
      ]
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "meaning",
          "dimension",
          "unit",
          "domain"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "dimension": {
            "type": "object",
            "required": [
              "L",
              "M",
              "T",
              "I",
              "Theta",
              "N",
              "J"
            ],
            "properties": {
              "L": {
                "type": "number"
              },
              "M": {
                "type": "number"
              },
              "T": {
                "type": "number"
              },
              "I": {
                "type": "number"
              },
              "Theta": {
                "type": "number"
              },
              "N": {
                "type": "number"
              },
              "J": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "unit": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "coordinate_space": {
            "type": [
              "string",
              "null"
            ]
          },
          "convention": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expression",
          "purpose",
          "status",
          "dimensional_check"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "derivation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "source_verified",
              "derived_and_checked",
              "approximation",
              "authored_convention",
              "schematic",
              "unverified"
            ]
          },
          "dimensional_check": {
            "enum": [
              "pass",
              "fail",
              "not_applicable",
              "pending"
            ]
          },
          "source_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "required": [
        "status",
        "steps"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "not_documented",
            "not_applicable"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "unit",
          "constraints"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "constraints": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "algorithm_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "pseudocode": {
      "type": "string",
      "minLength": 20
    },
    "complexity": {
      "type": "object",
      "required": [
        "time",
        "space"
      ],
      "properties": {
        "time": {
          "type": "string"
        },
        "space": {
          "type": "string"
        },
        "convergence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "implementation_mapping": {
      "type": "object",
      "required": [
        "threejs_api",
        "cpu_reference",
        "gpu_strategy"
      ],
      "properties": {
        "threejs_api": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_strategy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "supported_claim",
          "formula_locator",
          "formula_level_status"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "supported_claim": {
            "type": "string"
          },
          "formula_locator": {
            "type": "string"
          },
          "formula_level_status": {
            "enum": [
              "verified",
              "partial",
              "not_verified",
              "authored_convention"
            ]
          }
        }
      }
    },
    "independent_tests": {
      "type": "object",
      "required": [
        "python",
        "javascript",
        "edge_cases"
      ],
      "properties": {
        "python": {
          "type": "array",
          "minItems": 1
        },
        "javascript": {
          "type": "array",
          "minItems": 1
        },
        "edge_cases": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "readiness_status": {
      "enum": [
        "IMPLEMENTATION_READY",
        "INCOMPLETE",
        "BLOCKED",
        "PRESERVED_CRIMSON_LOONG"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness_status": {
            "const": "IMPLEMENTATION_READY"
          }
        }
      },
      "then": {
        "properties": {
          "derivation": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "equations": {
            "items": {
              "properties": {
                "dimensional_check": {
                  "const": "pass"
                },
                "status": {
                  "enum": [
                    "source_verified",
                    "derived_and_checked",
                    "approximation",
                    "authored_convention"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}